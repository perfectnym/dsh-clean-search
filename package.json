{
  "name": "dsh-clean-search",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "清爽搜索：基于 DeepSeek Search API 的无广告搜索首页，含天气、行情 K 线/分时、以图搜图与官网优先排序。",
  "exports": {
    ".": "./index.js",
    "./client": "./client/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
